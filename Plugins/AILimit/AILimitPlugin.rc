#include "resource.h"
#include <windows.h>
#pragma code_page(65001)

IDD_AI_OPTIONS DIALOGEX 0, 0, 420, 356
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AI 额度设置"
FONT 9, "微软雅黑"
BEGIN
    LTEXT           "预设:", -1, 7, 7, 22, 8
    COMBOBOX        IDC_COMBO_PRESET, 30, 5, 150, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "傻瓜模式: 选推荐即可，小白只需填密钥", IDC_STATIC_HELP, 190, 7, 223, 8

    GROUPBOX        "API 密钥 (必填，填好点右侧测试)", -1, 7, 19, 406, 96
    LTEXT           "Go 密钥1:", -1, 12, 32, 45, 8
    EDITTEXT        IDC_EDIT_GO_KEY1, 60, 30, 138, 12, ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "显", IDC_BTN_SHOW_GO1, 200, 30, 20, 12
    LTEXT           "名称:", -1, 224, 32, 22, 8
    EDITTEXT        IDC_EDIT_GO_KEY1_NAME, 248, 30, 48, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "获取", IDC_BTN_GOTO_GO, 300, 30, 34, 12
    PUSHBUTTON      "测试1", IDC_BTN_TEST_GO1, 338, 30, 60, 12
    LTEXT           "Go 密钥2:", -1, 12, 48, 45, 8
    EDITTEXT        IDC_EDIT_GO_KEY2, 60, 46, 138, 12, ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "显", IDC_BTN_SHOW_GO2, 200, 46, 20, 12
    LTEXT           "名称:", -1, 224, 48, 22, 8
    EDITTEXT        IDC_EDIT_GO_KEY2_NAME, 248, 46, 48, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "获取", IDC_BTN_GOTO_GO2, 300, 46, 34, 12
    PUSHBUTTON      "测试2", IDC_BTN_TEST_GO2, 338, 46, 60, 12
    LTEXT           "OR 密钥:", -1, 12, 64, 45, 8
    EDITTEXT        IDC_EDIT_OR_KEY, 60, 62, 138, 12, ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "显", IDC_BTN_SHOW_OR, 200, 62, 20, 12
    PUSHBUTTON      "获取OR", IDC_BTN_GOTO_OR, 300, 62, 34, 12
    PUSHBUTTON      "测试OR", IDC_BTN_TEST_OR, 338, 62, 60, 12
    LTEXT           "DS 密钥:", -1, 12, 80, 45, 8
    EDITTEXT        IDC_EDIT_DS_KEY, 60, 78, 138, 12, ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "显", IDC_BTN_SHOW_DS, 200, 78, 20, 12
    PUSHBUTTON      "获取DS", IDC_BTN_GOTO_DS, 300, 78, 34, 12
    PUSHBUTTON      "测试DS", IDC_BTN_TEST_DS, 338, 78, 60, 12
    LTEXT           "", IDC_STATIC_TEST_RESULT, 12, 94, 390, 8

    GROUPBOX        "端点 (一般不用动)", IDC_GROUP_ADV, 7, 119, 406, 30
    LTEXT           "Go端点:", IDC_STATIC_GOEP, 12, 131, 34, 8
    EDITTEXT        IDC_EDIT_ENDPOINT_GO, 48, 129, 104, 11, ES_AUTOHSCROLL
    LTEXT           "OR端点:", IDC_STATIC_OREP, 158, 131, 34, 8
    EDITTEXT        IDC_EDIT_ENDPOINT_OR, 194, 129, 104, 11, ES_AUTOHSCROLL
    LTEXT           "DS端点:", IDC_STATIC_DSEP, 304, 131, 30, 8
    EDITTEXT        IDC_EDIT_ENDPOINT_DS, 336, 129, 62, 11, ES_AUTOHSCROLL

    GROUPBOX        "显示项 (勾选=显示在任务栏)", -1, 7, 153, 406, 64
    AUTOCHECKBOX    "Go 上", IDC_CHECK_GO_TOP, 12, 164, 55, 10
    AUTOCHECKBOX    "Go 下", IDC_CHECK_GO_BOTTOM, 72, 164, 55, 10
    AUTOCHECKBOX    "Go2 上", IDC_CHECK_GO2_TOP, 132, 164, 55, 10
    AUTOCHECKBOX    "Go2 下", IDC_CHECK_GO2_BOTTOM, 192, 164, 55, 10
    AUTOCHECKBOX    "OR 上", IDC_CHECK_OR_TOP, 252, 164, 55, 10
    AUTOCHECKBOX    "OR 下", IDC_CHECK_OR_BOTTOM, 312, 164, 55, 10
    AUTOCHECKBOX    "DS 上", IDC_CHECK_DS_TOP, 12, 180, 55, 10
    AUTOCHECKBOX    "DS 下", IDC_CHECK_DS_BOTTOM, 72, 180, 55, 10
    LTEXT           "效果:", -1, 132, 181, 26, 8
    COMBOBOX        IDC_COMBO_DISPLAY_MODE, 160, 179, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "颜色:", -1, 246, 181, 26, 8
    COMBOBOX        IDC_COMBO_COLOR_MODE, 274, 179, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "宽度:", -1, 12, 197, 26, 8
    EDITTEXT        IDC_EDIT_WIDTH, 40, 195, 30, 12, ES_NUMBER
    CONTROL         "", IDC_SPIN_WIDTH, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 70, 195, 10, 12
    AUTOCHECKBOX    "显示标签", IDC_CHECK_SHOW_GO_LABEL, 90, 197, 60, 10

    GROUPBOX        "其他", -1, 7, 221, 406, 52
    AUTOCHECKBOX    "显示重置时间", IDC_CHECK_SHOW_RESET_TIME, 12, 232, 80, 10
    LTEXT           "重置格式:", -1, 100, 233, 45, 8
    COMBOBOX        IDC_COMBO_RESET_FORMAT, 147, 231, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "刷新秒:", -1, 258, 233, 30, 8
    EDITTEXT        IDC_EDIT_INTERVAL, 290, 231, 38, 12, ES_NUMBER
    CONTROL         "", IDC_SPIN_INTERVAL, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 328, 231, 10, 12
    AUTOCHECKBOX    "用完/过期自动隐藏", IDC_CHECK_HIDE_EXPIRED, 12, 249, 130, 10
    AUTOCHECKBOX    "电池省电自动降帧", IDC_CHECK_BATTERY_AUTO, 150, 249, 130, 10

    GROUPBOX        "预览 (真实数据，无数据时标示例，隐藏项标[藏])", -1, 7, 277, 406, 48
    LTEXT           "上排:", -1, 12, 291, 20, 8
    LTEXT           "--", IDC_STATIC_PREVIEW_TOP, 35, 291, 370, 8
    LTEXT           "下排:", -1, 12, 306, 20, 8
    LTEXT           "--", IDC_STATIC_PREVIEW_BOT, 35, 306, 370, 8

    DEFPUSHBUTTON   "确定", IDOK, 190, 333, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 250, 333, 50, 14
    PUSHBUTTON      "应用", IDC_BTN_APPLY, 310, 333, 50, 14
END
